# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wedding:wedding@postgres:5432/wedding

# ── Invite codes (generate with: python -c "import secrets; print(secrets.token_urlsafe(22))")
INVITE_TOKEN_FULL=REPLACE_ME_FULL
INVITE_TOKEN_RECEPTION=REPLACE_ME_RECEPTION

# ── JWT / session ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=wss

# ── MinIO (local S3-compatible storage) ──────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wedding-photos

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Server-side URL used by Next.js BFF to call the backend
API_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must match JWT_SECRET above — used to verify the session cookie in middleware
SESSION_SECRET=REPLACE_ME_JWT_SECRET
# Admin session cookie name (must match ADMIN_COOKIE_NAME in backend)
ADMIN_COOKIE_NAME=wsa

# ── Admin auth ────────────────────────────────────────────────────────────────
# The couple's admin login credentials — keep these secret in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
# The public URL used for QR code generation (must match your deployed frontend URL)
SITE_URL=https://your-wedding-site.vercel.app

# ── Planner account (optional) ────────────────────────────────────────────────
# Limited access: Invite Links + Guests & Tables only (no Photos tab)
# Leave blank to disable the planner login.
PLANNER_USERNAME=planner
PLANNER_PASSWORD=REPLACE_ME_PLANNER_PASSWORD
